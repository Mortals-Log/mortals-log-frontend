{
	"compilerOptions": {
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"],
			"@components/*": ["src/components/*"],
			"@pages/*": ["src/pages/*"],
			"@assets/*": ["src/assets/*"],
			"@const/*": ["src/const/*"],
			"@store/*": ["src/store/*"],
			"@styles/*": ["src/styles/*"],
			"@types/*": ["src/types/*"],
			"@utils/*": ["src/utils/*"],
			"@hooks/*": ["src/hooks/*"]
		},
		"typeRoots": ["node_modules/@types", "src/types"],
		"types": ["vite/client", "vite-plugin-svgr/client"],
		"allowImportingTsExtensions": true,
		"noEmit": true
	},
	"files": [],
	"references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }]
}
